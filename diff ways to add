class Solution(object):

    def diffWaysToCompute(self, expression):
        """
        :type expression: str
        :rtype: List[int]
        """

        results = []

        for i in range(len(expression)):
            if expression[i] in "+-*":
                left = self.diffWaysToCompute(expression[:i])
                right = self.diffWaysToCompute(expression[i + 1:])

                for l in left:
                    for r in right:
                        if expression[i] == '+':
                            results.append(l + r)
                        elif expression[i] == '-':
                            results.append(l - r)
                        else:
                            results.append(l * r)

        if not results:
            results.append(int(expression))

        return results
